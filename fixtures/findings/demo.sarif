          "message": {
            "text": "User-controlled URL passed to http.get without allowlist"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/fetch.js" },
                "region": { "startLine": 8, "endLine": 18 }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "semgrep-ssrf-001"
          }
        },
        {
          "ruleId": "javascript.lang.security.audit.xss.direct-response-write",
          "level": "warning",
          "message": {
            "text": "Unescaped user input written to HTTP response"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/server.js" },
                "region": { "startLine": 29, "endLine": 31 }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "semgrep-xss-001"
          }
        },
        {
          "ruleId": "javascript.lang.security.audit.open-redirect",
          "level": "warning",
          "message": {
            "text": "Redirect target taken directly from query parameter"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/redirect.js" },
