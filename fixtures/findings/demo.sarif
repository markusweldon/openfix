{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "informationUri": "https://semgrep.dev",
          "rules": [
            {
              "id": "javascript.lang.security.audit.path-traversal.path-join-resolve-traversal",
              "name": "path-traversal",
              "shortDescription": {
                "text": "Path traversal via user-controlled path join"
              },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "8.0",
                "tags": ["security", "sast", "path-traversal"]
              }
            },
            {
              "id": "javascript.lang.security.audit.command-injection-child-process",
              "name": "command-injection",
              "shortDescription": {
                "text": "OS command injection via child_process.exec"
              },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "8.5",
                "tags": ["security", "sast", "command-injection"]
              }
            },
            {
              "id": "javascript.lang.security.audit.eval-detected",
              "name": "code-injection-eval",
              "shortDescription": { "text": "User input reaches eval()" },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "8.2",
                "tags": ["security", "sast", "code-injection"]
              }
            },
            {
              "id": "javascript.lang.security.audit.ssrf",
              "name": "ssrf",
              "shortDescription": {
                "text": "Server-side request forgery via user-controlled URL"
              },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "7.5",
                "tags": ["security", "sast", "ssrf"]
              }
            },
            {
              "id": "javascript.lang.security.audit.xss.direct-response-write",
              "name": "reflected-xss",
              "shortDescription": { "text": "Potential reflected XSS" },
              "defaultConfiguration": { "level": "warning" },
              "properties": {
                "security_severity": "5.0",
                "tags": ["security", "sast", "xss"]
              }
            },
            {
              "id": "javascript.lang.security.audit.open-redirect",
              "name": "open-redirect",
              "shortDescription": { "text": "Open redirect from query parameter" },
              "defaultConfiguration": { "level": "warning" },
              "properties": {
                "security_severity": "4.5",
                "tags": ["security", "sast", "open-redirect"]
              }
            },
            {
              "id": "javascript.lang.security.audit.detect-hardcoded-secret",
              "name": "hardcoded-secret",
              "shortDescription": { "text": "Hardcoded secret in auth module" },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "9.5",
                "tags": ["security", "secret"]
              }
            },
            {
              "id": "javascript.style.no-var",
              "name": "style-no-var",
              "shortDescription": { "text": "Prefer const/let over var" },
              "defaultConfiguration": { "level": "note" },
              "properties": {
                "security_severity": "0.0",
                "tags": ["style"]
              }
            },
            {
              "id": "javascript.lang.security.audit.vm-runinnewcontext",
              "name": "code-injection-vm",
              "shortDescription": {
                "text": "User input executed via vm.runInNewContext"
              },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "8.3",
                "tags": ["security", "sast", "code-injection"]
              }
            },
            {
              "id": "javascript.lang.security.audit.weak-crypto-createcipher",
              "name": "weak-crypto",
              "shortDescription": {
                "text": "Deprecated createCipher with password-derived key"
              },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "7.1",
                "tags": ["security", "sast", "crypto"]
              }
            },
            {
              "id": "javascript.lang.security.audit.sql-injection-string-concat",
              "name": "sql-injection",
              "shortDescription": {
                "text": "SQL query built via string concatenation"
              },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "8.1",
                "tags": ["security", "sast", "sql-injection"]
              }
            },
            {
              "id": "javascript.lang.security.audit.cors-misconfiguration",
              "name": "cors-wildcard-credentials",
              "shortDescription": {
                "text": "CORS allows origin * with credentials"
              },
              "defaultConfiguration": { "level": "warning" },
              "properties": {
                "security_severity": "5.5",
                "tags": ["security", "sast", "cors"]
              }
            },
            {
              "id": "javascript.lang.security.audit.execfile-shell-true",
              "name": "command-injection-execfile",
              "shortDescription": {
                "text": "execFile with shell:true and user-controlled args"
              },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security_severity": "8.4",
                "tags": ["security", "sast", "command-injection"]
              }
            },
            {
              "id": "javascript.lang.security.audit.xss.html-string-concat",
              "name": "html-xss-concat",
              "shortDescription": {
                "text": "Unescaped user HTML concatenated into response"
              },
              "defaultConfiguration": { "level": "warning" },
              "properties": {
                "security_severity": "5.2",
                "tags": ["security", "sast", "xss"]
              }
            },
            {
              "id": "javascript.lang.security.audit.unsafe-object-assign-merge",
              "name": "unsafe-config-merge",
              "shortDescription": {
                "text": "Untrusted JSON merged into shared config object"
              },
              "defaultConfiguration": { "level": "warning" },
              "properties": {
                "security_severity": "6.0",
                "tags": ["security", "sast", "prototype-pollution"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "javascript.lang.security.audit.path-traversal.path-join-resolve-traversal",
          "level": "error",
          "message": {
            "text": "User-controlled input flows into path.join without sanitization"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/files.js" },
                "region": { "startLine": 8, "endLine": 12 }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "semgrep-path-traversal-001"
          }
        },
        {
          "ruleId": "javascript.lang.security.audit.command-injection-child-process",
          "level": "error",
          "message": {
            "text": "User-controlled host concatenated into shell command in pingHost"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/exec.js" },
