          }
        },
        {
          "ruleId": "javascript.lang.security.audit.cors-misconfiguration",
          "level": "warning",
          "message": {
            "text": "Access-Control-Allow-Origin set to * with Allow-Credentials true"
          },
          "locations": [
            {
              "physicalLocation": {
