          "partialFingerprints": {
            "primaryLocationLineHash": "semgrep-open-redirect-001"
          }
        },
        {
          "ruleId": "javascript.lang.security.audit.detect-hardcoded-secret",
          "level": "error",
          "message": {
            "text": "Hardcoded API token in auth module — requires human handling"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/auth/tokens.js" },
                "region": { "startLine": 3, "endLine": 3 }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "semgrep-secret-auth-001"
          }
        },
        {
          "ruleId": "javascript.style.no-var",
          "level": "note",
          "message": { "text": "Unexpected var, use let or const" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/server.js" },
                "region": { "startLine": 3, "endLine": 3 }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "semgrep-style-noise-001"
          }
        },
        {
          "ruleId": "javascript.lang.security.audit.vm-runinnewcontext",
          "level": "error",
          "message": {
            "text": "User-controlled code executed via vm.runInNewContext in runUserScript"
