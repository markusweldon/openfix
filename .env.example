# Required for openfix remediate / status / resume (cloud agents)
CURSOR_API_KEY=cursor_...

# GitHub repo URL the cloud agent clones (local CLI / cross-repo override).
# In GitHub Actions, omit this — OpenFix derives https://github.com/$GITHUB_REPOSITORY.
# Example: https://github.com/your-org/openfix-demo-app
OPENFIX_TARGET_REPO=

# Optional: branch or commit for the agent clone (default: main).
# Prefer OPENFIX_COMMIT_SHA when binding to a scanned snapshot.
OPENFIX_STARTING_REF=main

# Optional: scanned commit SHA (pipeline: set from github.sha).
# When set, remediate prefers this over OPENFIX_STARTING_REF.
OPENFIX_COMMIT_SHA=

# Optional: stable OpenFix job id (pipeline: github.run_id). Auto-generated locally.
# OPENFIX_RUN_ID=

# Optional: model id (default: composer-2.5)
OPENFIX_MODEL=composer-2.5

# Optional: max concurrent remediation agents (default: 2)
OPENFIX_MAX_CONCURRENT=2
