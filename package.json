{
  "name": "openfix",
  "version": "0.2.0",
  "description": "Findings intelligence: provenance, enrichment, validation, triage and controlled remediation",
  "type": "module",
  "bin": {
    "openfix": "./src/openfix.mjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node src/openfix.mjs",
    "openfix": "node src/openfix.mjs",
    "legacy": "tsx src/cli.ts",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "demo": "node src/openfix.mjs demo",
    "typecheck": "tsc --noEmit",
    "test:lifecycle": "node --test --experimental-test-isolation=none tests/lifecycle.test.mjs",
    "demo:lifecycle": "node scripts/demo-lifecycle.mjs",
    "assets:prep": "python scripts/build-prep-assets.py"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.26",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}

